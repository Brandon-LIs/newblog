{
  "redirects": [
    {
      "source": "/rss.xml",
      "destination": "/blog/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed.xml",
      "destination": "/blog/rss.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/friends-feed.json",
      "destination": "https://raw.githubusercontent.com/Brandon-LIs/friend-data/refs/heads/main/friend-articles.json"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/friends-feed.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=1740, max-age=1740, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/blog/rss.xml",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/blog/atom.xml",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/ai-summaries.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" }
      ]
    }
  ]
}
